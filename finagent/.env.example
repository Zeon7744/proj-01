# 示例环境变量。复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）。
# ALPHAVANTAGE_API_KEY 缺失时系统自动回退到确定性模拟数据，功能仍可完整演示。

# 真实行情数据源 key（可选；强烈建议生产环境配置）
ALPHAVANTAGE_API_KEY=

# 管理员 API key（默认 fa_admin，生产请改为随机值）
# FINAGENT_ADMIN_KEY=

# 本地控制台是否允许无 key 降级为 admin（生产务必设为 0）
# FINAGENT_LOCAL_OPEN=0

# 数据目录（默认 ./data）
# FINAGENT_DATA_DIR=

# 服务端口（默认 3001）
# PORT=3001
