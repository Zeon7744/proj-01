# 示例环境变量。复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）。
# ALPHAVANTAGE_API_KEY 缺失时系统自动回退到确定性模拟数据，功能仍可完整演示。

# 真实行情数据源 key（可选；生产建议配置）
ALPHAVANTAGE_API_KEY=

# 管理员 API key（默认 fa_admin，生产务必改为随机值）
# FINAGENT_ADMIN_KEY=
# FINAGENT_ANALYST_KEY=
# FINAGENT_VIEWER_KEY=

# 严格密钥模式：1 = 必须提供 key，关闭“无 key 降级 admin”（生产推荐）
# FINAGENT_STRICT_KEYS=1

# 本地控制台是否允许无 key 降级为 admin（生产务必设为 0）
# FINAGENT_LOCAL_OPEN=0

# 接口限流：每 60 秒每 key 允许请求数（默认 120）
# FINAGENT_RATE_MAX=120

# 数据目录（默认 ./data）
# FINAGENT_DATA_DIR=

# 服务端口（默认 3001）
# PORT=3001

# 是否自启后台定时任务（1 开启）
# FINAGENT_AUTOSTART_JOBS=1
# FINAGENT_JOB_VERSION=full

# 调试日志（1 开启 info 级别以上额外 debug）
# DEBUG=
