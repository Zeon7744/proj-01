{
  "name": "finagent",
  "version": "1.1.0",
  "description": "FinAgent - global financial data collection & high-precision in-house analysis agent (lite/full), multi-source collection + self-upgrade + hit-rate backtest + RBAC + open API + three-end sharing + ops",
  "main": "server.js",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "serve": "node scripts/serve.js",
    "serve:daemon": "node scripts/serve.js --daemon",
    "serve:stop": "node scripts/serve.js --stop",
    "collect:lite": "node scripts/collect-lite.js",
    "collect:full": "node scripts/collect-full.js",
    "backtest": "node scripts/backtest.js",
    "ops:audit": "node scripts/ops.js audit",
    "ops:backup": "node scripts/ops.js backup",
    "ops:prune": "node scripts/ops.js prune --keep-days 30",
    "ops:jobs": "node scripts/ops.js jobs --version full",
    "test": "node --test test/engines.test.js test/shared.test.js test/middleware.test.js",
    "test:all": "node --test test/engines.test.js test/shared.test.js"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "finance",
    "data-collection",
    "analysis",
    "prediction",
    "self-upgrading",
    "backtest",
    "agent",
    "rbac",
    "open-api",
    "ops",
    "shared-contract"
  ]
}

